{
  "permissions": {
    "allow": [
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(kubectl -n discord get:*)",
      "Bash(kubectl -n discord describe:*)",
      "Bash(kubectl -n discord logs:*)",
      "Bash(kubectl -n discord top:*)",
      "Bash(kubectl -n discord rollout status:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(docker compose up:*)",
      "Bash(python3 bot/main.py:*)",
      "Bash(python bot/main.py:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
