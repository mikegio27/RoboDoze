DISCORD_TOKEN=your_token_here
# COMMAND_PREFIX=!dozy   # code default; production uses rd-
# HEALTH_PORT=8080
# LOG_LEVEL=INFO         # DEBUG is very verbose
# LOG_FORMAT=text        # or json (one object per line)
# DOZAI_TOKEN=dzai_…     # dozai service token; unset = rd-ask is off
# DOZAI_URL=http://dozai.dozai.svc.cluster.local:8080
# DOZAI_MODEL=persona:RoboDoze   # or auto
# DOZAI_WEB=true
# DOZAI_CODE=true
# LOBBY_BOT_TOKEN=…      # dozy-lobby bot API token; unset = rd-games / rd-game are off
# LOBBY_URL=http://lobby.dozy-lobby.svc.cluster.local:8081
# GAMES_GUILD_IDS=1554708052593348729,385602741101264896   # DozyNet, HCH: the only guilds where they work
